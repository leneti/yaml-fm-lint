{
  "author": "Dominykas Gudauskas <leneti>",
  "name": "yaml-fm-lint",
  "description": "nodejs linter for yaml front matter in markdown files",
  "version": "1.8.0",
  "license": "MIT",
  "main": "./index.js",
  "bin": "./cli.js",
  "type": "module",
  "files": [
    "index.js",
    "cli.js",
    "errors.js",
    "config/"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "fmlint": "node cli.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "glob": "^14.0.3",
    "js-yaml": "^4.3.2"
  },
  "keywords": [
    "yaml",
    "lint",
    "nodejs",
    "frontmatter",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leneti/yaml-fm-lint.git"
  },
  "bugs": {
    "url": "https://github.com/leneti/yaml-fm-lint/issues"
  },
  "homepage": "https://github.com/leneti/yaml-fm-lint#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "vitest": "^5.1.0"
  }
}
